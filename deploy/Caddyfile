# /etc/caddy/Caddyfile
# Cloudflare (proxied, SSL mode "Full (strict)") -> Caddy (Cloudflare Origin
# Certificate) -> gunicorn on 127.0.0.1:8000.

{
	# Origin cert is installed manually; no ACME needed behind Cloudflare.
	auto_https disable_certs
	servers {
		# Only trust client-IP headers from Cloudflare's edge.
		# Source: https://www.cloudflare.com/ips/
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(origin_tls) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
}

www.kenkrislogistics.co.ke {
	import origin_tls
	redir https://kenkrislogistics.co.ke{uri} permanent
}

kenkrislogistics.co.ke {
	import origin_tls
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	reverse_proxy 127.0.0.1:8000 {
		header_up X-Real-IP {client_ip}
	}

	log {
		output file /var/log/caddy/kenkris.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
