# Copy to .env and fill in. Never commit .env.

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets
DJANGO_ALLOWED_HOSTS=kenkrislogistics.co.ke,www.kenkrislogistics.co.ke
DJANGO_CSRF_TRUSTED_ORIGINS=https://kenkrislogistics.co.ke,https://www.kenkrislogistics.co.ke
# Leave empty to keep the built-in Django admin switched off (recommended).
DJANGO_ADMIN_URL=
# Raise to 31536000 once HTTPS is confirmed working on the domain.
DJANGO_HSTS_SECONDS=0

POSTGRES_DB=kenkris
POSTGRES_USER=kenkris
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SMTP for quote notifications. Leave EMAIL_HOST empty to log emails instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=KenKris Website <no-reply@kenkrislogistics.co.ke>
QUOTE_NOTIFY_EMAIL=

QUOTE_RATE_LIMIT_PER_HOUR=5
